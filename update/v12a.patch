+<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Download Internot AI, maps and AI models</title>
+<meta name="description" content="Internot AI works with no internet. Download the app, country maps and AI models once, then use them offline.">
