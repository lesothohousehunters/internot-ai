+<style>
+:root { --bg:#f0eee6; --panel:#faf9f5; --panel2:#e8e4d8; --line:#d9d4c4; --text:#1f1e1d; --muted:#6b6860; --accent:#d97757; --deep:#c15f3c; --serif:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif; }
+* { box-sizing:border-box; }
+body { margin:0; background:var(--bg); color:var(--text); font:16px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
+header { max-width:880px; margin:0 auto; padding:28px 20px 8px; display:flex; align-items:center; gap:12px; }
+header b { font-family:var(--serif); font-size:24px; }
+main { max-width:880px; margin:0 auto; padding:0 20px 40px; }
+h1 { font-family:var(--serif); font-weight:600; font-size:34px; line-height:1.15; margin:10px 0 8px; }
+h2 { font-family:var(--serif); font-weight:600; font-size:24px; margin:34px 0 10px; }
+.lead { color:var(--muted); font-size:18px; margin:0 0 6px; }
+.card { background:var(--panel); border:1px solid var(--line); border-radius:16px; padding:16px; margin-bottom:12px; }
+.item { display:flex; gap:14px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
+.item .t { flex:1; min-width:230px; } .item b { font-size:17px; } .item small { display:block; color:var(--muted); }
+.tag { display:inline-block; background:var(--panel2); border-radius:99px; padding:1px 9px; font-size:12px; color:var(--muted); margin-left:6px; vertical-align:2px; }
+.tag.on { background:var(--accent); color:#fff; }
