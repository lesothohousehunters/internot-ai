diff --git a/android/RunPlugin.java b/android/RunPlugin.java
new file mode 100644
index 0000000..841d08d
--- /dev/null
+++ b/android/RunPlugin.java
@@ -0,0 +1,143 @@
+package org.internot.app;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.Intent;
+import android.location.LocationManager;
+import android.net.Uri;
+import android.os.Build;
+import android.util.Base64;
+import androidx.core.app.ActivityCompat;
+import androidx.core.content.ContextCompat;
+import androidx.core.content.FileProvider;
+import com.getcapacitor.JSArray;
+import com.getcapacitor.JSObject;
+import com.getcapacitor.PermissionState;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import com.getcapacitor.annotation.Permission;
+import com.getcapacitor.annotation.PermissionCallback;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.util.ArrayList;
+import java.util.List;
+import org.json.JSONArray;
+
+/** Run tab: GPS recording that keeps going with the screen off, and saving a replay video. */
+@CapacitorPlugin(name = "Run", permissions = {
+        @Permission(alias = "location", strings = { Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION })
+})
+public class RunPlugin extends Plugin {
+
+    private boolean gpsOn() {
+        LocationManager lm = (LocationManager) getContext().getSystemService(Context.LOCATION_SERVICE);
+        try { return lm != null && lm.isProviderEnabled(LocationManager.GPS_PROVIDER); } catch (Exception e) { return false; }
+    }
+
+    @PluginMethod
+    public void start(PluginCall call) {
+        if (getPermissionState("location") != PermissionState.GRANTED) { requestPermissionForAlias("location", call, "afterLocation"); return; }
+        begin(call);
+    }
+
+    @PermissionCallback
+    private void afterLocation(PluginCall call) {
+        if (getPermissionState("location") == PermissionState.GRANTED) begin(call);
+        else call.reject("Allow location for Internot AI to record a run. GPS works with no internet.");
+    }
+
+    private void begin(PluginCall call) {
+        if (!gpsOn()) { call.reject("Location (GPS) is switched off. Turn on Location in the phone's quick settings, then press Start again."); return; }
+        if (Build.VERSION.SDK_INT >= 33 && ContextCompat.checkSelfPermission(getContext(), "android.permission.POST_NOTIFICATIONS") != android.content.pm.PackageManager.PERMISSION_GRANTED) {
+            try { ActivityCompat.requestPermissions(getActivity(), new String[] { "android.permission.POST_NOTIFICATIONS" }, 4107); } catch (Exception ignored) { }
+        }
+        if (!RunService.running) {
+            RunService.prepare(getContext(), call.getBoolean("keep", false));
+            ContextCompat.startForegroundService(getContext(), new Intent(getContext(), RunService.class));
+        }
+        RunService.paused = false;
+        call.resolve(state());
+    }
+
+    @PluginMethod
+    public void pause(PluginCall call) { RunService.paused = true; call.resolve(state()); }
+
+    @PluginMethod
+    public void resume(PluginCall call) {
+        if (RunService.paused) { RunService.segment++; RunService.paused = false; }
+        call.resolve(state());
+    }
+
+    @PluginMethod
+    public void stop(PluginCall call) {
+        getContext().stopService(new Intent(getContext(), RunService.class));
+        RunService.running = false;
+        call.resolve(state());
+    }
+
+    /** Forget the saved fixes (after the run is saved in the app, or thrown away). */
+    @PluginMethod
+    public void clear(PluginCall call) {
+        if (!RunService.running) { RunService.points.clear(); RunService.file(getContext()).delete(); }
+        call.resolve();
+    }
+
+    @PluginMethod
+    public void status(PluginCall call) { call.resolve(state()); }
+
+    private JSObject state() {
+        JSObject o = new JSObject();
+        o.put("running", RunService.running);
+        o.put("paused", RunService.paused);
+        o.put("count", RunService.running ? RunService.points.size() : RunService.fromFile(getContext()).size());
+        o.put("gps", gpsOn());
+        o.put("lastFix", RunService.lastFix);
+        o.put("accuracy", RunService.lastAccuracy);
+        o.put("error", RunService.error);
+        return o;
+    }
+
+    /** Fixes from number `from` on: from memory while recording, otherwise from the saved file. */
+    @PluginMethod
+    public void points(PluginCall call) {
+        int from = Math.max(0, call.getInt("from", 0));
+        List<double[]> src;
+        if (RunService.running) { synchronized (RunService.points) { src = new ArrayList<>(RunService.points); } }
+        else src = RunService.fromFile(getContext());
+        JSArray list = new JSArray();
+        try {
+            for (int i = from; i < src.size(); i++) {
+                double[] p = src.get(i); JSONArray a = new JSONArray();
+                for (double v : p) a.put(v);
+                list.put(a);
+            }
+        } catch (Exception e) { call.reject(e.getMessage()); return; }
+        JSObject o = new JSObject(); o.put("points", list); o.put("total", src.size());
+        call.resolve(o);
+    }
+
+    /** Saves a replay video and opens the share menu (save to the gallery, WhatsApp, Quick Share...). */
+    @PluginMethod
+    public void shareVideo(PluginCall call) {
+        String data = call.getString("data"), name = call.getString("name", "internot-run.webm");
+        if (data == null) { call.reject("No video"); return; }
+        try {
+            File dir = new File(getContext().getCacheDir(), "videos"); dir.mkdirs();
+            for (File old : dir.listFiles() == null ? new File[0] : dir.listFiles()) old.delete();
+            File f = new File(dir, name.replaceAll("[^A-Za-z0-9._-]", "_"));
+            try (FileOutputStream o = new FileOutputStream(f)) { o.write(Base64.decode(data, Base64.DEFAULT)); }
+            Uri uri = FileProvider.getUriForFile(getContext(), getContext().getPackageName() + ".fileprovider", f);
+            Intent send = new Intent(Intent.ACTION_SEND);
+            send.setType(call.getString("type", "video/webm"));
+            send.putExtra(Intent.EXTRA_STREAM, uri);
+            send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
+            Intent chooser = Intent.createChooser(send, "Share your run video");
+            chooser.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            getContext().startActivity(chooser);
+            JSObject o = new JSObject(); o.put("path", f.getAbsolutePath()); o.put("bytes", f.length());
+            call.resolve(o);
+        } catch (Exception e) { call.reject("Could not save the video: " + e.getMessage()); }
+    }
+}
diff --git a/android/RunService.java b/android/RunService.java
new file mode 100644
index 0000000..4cb17fb
--- /dev/null
+++ b/android/RunService.java
@@ -0,0 +1,156 @@
+package org.internot.app;
+
+import android.app.Notification;
+import android.app.NotificationChannel;
+import android.app.NotificationManager;
+import android.app.PendingIntent;
+import android.app.Service;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ServiceInfo;
+import android.location.Location;
+import android.location.LocationListener;
+import android.location.LocationManager;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.Looper;
+import android.os.PowerManager;
+import androidx.core.app.NotificationCompat;
+import androidx.core.app.ServiceCompat;
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.io.FileWriter;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Records a run or walk from the phone's GPS, also while the screen is off. GPS needs no internet,
+ * no SIM and no Google services. Every fix is also written to a file, so a run survives the app
+ * being closed by the phone. One fix: time, latitude, longitude, altitude, accuracy, speed, segment
+ * (the segment number goes up after each pause, so the gap is not counted as distance).
+ */
+public class RunService extends Service implements LocationListener {
+
+    static final List<double[]> points = Collections.synchronizedList(new ArrayList<>());
+    static volatile boolean running = false;
+    static volatile boolean paused = false;
+    static volatile int segment = 0;
+    static volatile long lastFix = 0;
+    static volatile float lastAccuracy = -1;
+    static volatile String error = null;
+
+    private LocationManager lm;
+    private PowerManager.WakeLock wake;
+    private FileWriter out;
+
+    static File file(Context c) { return new File(c.getFilesDir(), "run-current.csv"); }
+
+    /** Starts a new run (keep = false) or carries on with the one saved in the file. */
+    static void prepare(Context c, boolean keep) {
+        points.clear(); segment = 0; paused = false; error = null; lastFix = 0; lastAccuracy = -1;
+        File f = file(c);
+        if (!keep) { f.delete(); return; }
+        try (BufferedReader r = new BufferedReader(new FileReader(f))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                String[] a = line.split(","); if (a.length < 7) continue;
+                double[] p = new double[7];
+                for (int i = 0; i < 7; i++) p[i] = Double.parseDouble(a[i]);
+                points.add(p); segment = (int) p[6];
+            }
+        } catch (Exception ignored) { }
+        if (!points.isEmpty()) segment++;   // carrying on after a stop counts as a pause
+    }
+
+    /** The fixes saved in the file, when the app was closed during a run. */
+    static List<double[]> fromFile(Context c) {
+        List<double[]> list = new ArrayList<>();
+        try (BufferedReader r = new BufferedReader(new FileReader(file(c)))) {
+            String line;
+            while ((line = r.readLine()) != null) {
+                String[] a = line.split(","); if (a.length < 7) continue;
+                double[] p = new double[7];
+                for (int i = 0; i < 7; i++) p[i] = Double.parseDouble(a[i]);
+                list.add(p);
+            }
+        } catch (Exception ignored) { }
+        return list;
+    }
+
+    @Override
+    public void onCreate() {
+        super.onCreate();
+        NotificationManager nm = (NotificationManager) getSystemService(Context.NOTIFICATION_SERVICE);
+        if (Build.VERSION.SDK_INT >= 26 && nm != null) {
+            NotificationChannel ch = new NotificationChannel("run", "Run and walk recording", NotificationManager.IMPORTANCE_LOW);
+            ch.setDescription("Shown while Internot AI records a run or walk");
+            nm.createNotificationChannel(ch);
+        }
+        Intent open = new Intent(this, MainActivity.class);
+        open.setFlags(Intent.FLAG_ACTIVITY_SINGLE_TOP | Intent.FLAG_ACTIVITY_CLEAR_TOP);
+        PendingIntent pi = PendingIntent.getActivity(this, 0, open, PendingIntent.FLAG_IMMUTABLE | PendingIntent.FLAG_UPDATE_CURRENT);
+        Notification n = new NotificationCompat.Builder(this, "run")
+                .setSmallIcon(android.R.drawable.ic_menu_mylocation)
+                .setContentTitle("Internot AI is recording")
+                .setContentText("Your run or walk is being recorded with GPS. No internet used.")
+                .setOngoing(true)
+                .setContentIntent(pi)
+                .setPriority(NotificationCompat.PRIORITY_LOW)
+                .build();
+        int type = Build.VERSION.SDK_INT >= 29 ? ServiceInfo.FOREGROUND_SERVICE_TYPE_LOCATION : 0;
+        ServiceCompat.startForeground(this, 41, n, type);
+
+        PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
+        if (pm != null) { wake = pm.newWakeLock(PowerManager.PARTIAL_WAKE_LOCK, "internot:run"); wake.acquire(6L * 60 * 60 * 1000); }
+        try { out = new FileWriter(file(this), true); } catch (Exception e) { out = null; }
+        lm = (LocationManager) getSystemService(Context.LOCATION_SERVICE);
+        try {
+            lm.requestLocationUpdates(LocationManager.GPS_PROVIDER, 1000L, 0f, this, Looper.getMainLooper());
+            running = true;
+        } catch (SecurityException e) {
+            error = "Location permission is needed to record a run."; stopSelf();
+        } catch (Exception e) {
+            error = "This phone has no GPS available: " + e.getMessage(); stopSelf();
+        }
+    }
+
+    @Override
+    public int onStartCommand(Intent intent, int flags, int startId) { return START_NOT_STICKY; }
+
+    @Override
+    public void onLocationChanged(Location l) {
+        lastFix = System.currentTimeMillis();
+        lastAccuracy = l.hasAccuracy() ? l.getAccuracy() : -1;
+        if (paused) return;
+        double[] p = new double[] { l.getTime(), l.getLatitude(), l.getLongitude(),
+                l.hasAltitude() ? l.getAltitude() : -9999, l.hasAccuracy() ? l.getAccuracy() : -1,
+                l.hasSpeed() ? l.getSpeed() : -1, segment };
+        points.add(p);
+        if (out != null) {
+            try {
+                StringBuilder b = new StringBuilder();
+                for (int i = 0; i < 7; i++) { if (i > 0) b.append(','); b.append(i == 0 || i == 6 ? String.valueOf((long) p[i]) : String.valueOf(p[i])); }
+                out.write(b.append('\n').toString()); out.flush();
+            } catch (Exception ignored) { }
+        }
+    }
+
+    @Override public void onProviderEnabled(String provider) { error = null; }
+    @Override public void onProviderDisabled(String provider) { error = "Location (GPS) is switched off. Turn it on to keep recording."; }
+    @Override public void onStatusChanged(String provider, int status, Bundle extras) { }
+
+    @Override
+    public void onDestroy() {
+        running = false;
+        try { if (lm != null) lm.removeUpdates(this); } catch (Exception ignored) { }
+        try { if (out != null) out.close(); } catch (Exception ignored) { }
+        try { if (wake != null && wake.isHeld()) wake.release(); } catch (Exception ignored) { }
+        super.onDestroy();
+    }
+
+    @Override
+    public IBinder onBind(Intent intent) { return null; }
+}
