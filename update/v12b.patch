+  const ok = (P.catalog.models || []).filter((m) => fits(m) && (NATIVE || !m.nativeOnly)).sort((a, b) => (b.ram || 0) - (a.ram || 0));
+  return ok[0]?.id || (P.catalog.models || [])[0]?.id;
